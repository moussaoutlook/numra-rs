---
import { getCollection, render } from 'astro:content';
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const examples = await getCollection('examples');
  return examples.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Resolve the source file relative to the repo root. CWD when astro
// runs (locally and in CI) is `website/examples`, so the example
// sources are 2 levels up under `numra/examples/`.
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
const sourcePath = resolve(process.cwd(), '../..', entry.data.source_path);
const sourceText = readFileSync(sourcePath, 'utf-8');

// Trim leading doc-comment block — readers can see the same prose at
// the top of the page already; the in-source `//!` block duplicates it.
const sourceTrimmed = sourceText.replace(/^(\s*\/\/!.*\n)+\s*\n?/, '');
---

<BaseLayout
  title={`${entry.data.title} · Examples`}
  description={entry.data.summary}
  canonicalPath={`/${entry.id}`}
>
  <article class="example container">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/"><span class="arr">←</span> All examples</a>
    </nav>

    <header class="example-header">
      <p class="eyebrow">
        <span class="dot">●</span>
        {entry.data.equation_class} · {entry.data.complexity}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>

      <ul class="tags">
        <li class={`badge badge-${entry.data.equation_class.toLowerCase()}`}>
          {entry.data.equation_class}
        </li>
        <li class={`tag complexity-${entry.data.complexity}`}>{entry.data.complexity}</li>
        {entry.data.stiff && <li class="tag">stiff</li>}
        {entry.data.has_events && <li class="tag">events</li>}
        {entry.data.dense_output && <li class="tag">dense output</li>}
      </ul>
    </header>

    <section class="prose">
      <Content />
    </section>

    <section class="meta">
      <div class="meta-head">
        <p class="eyebrow"><span class="dot">●</span> Source</p>
        <h2>Runnable Rust source</h2>
      </div>
      <p class="meta-links">
        <a href={entry.data.source_link} rel="noopener">
          <code class="inline">{entry.data.source_path}</code> on GitHub <span class="arr">↗</span>
        </a>
        <span class="sep">·</span>
        <a href={entry.data.book_link} rel="noopener">Related book chapter <span class="arr">↗</span></a>
      </p>
      <Code code={sourceTrimmed} lang="rust" theme="github-light" />
    </section>
  </article>
</BaseLayout>

<style>
  .example {
    padding: 56px 0 96px;
    max-width: 80ch;
  }

  .crumb {
    margin-bottom: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .crumb a {
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .crumb a:hover { color: var(--color-fg-strong); }
  .crumb .arr { color: var(--color-accent); margin-right: 4px; }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 500;
    margin: 0 0 14px;
  }
  .eyebrow .dot { color: var(--color-accent); margin-right: 8px; }

  code.inline {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 1px 5px;
    background: var(--color-code-bg);
    color: var(--color-fg-strong);
    border-radius: 3px;
    border: 1px solid var(--color-border);
  }

  .example-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .example-header h1 {
    font-size: 44px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-fg-strong);
    margin: 0 0 14px;
    max-width: none;
  }

  .summary {
    color: var(--color-fg-muted);
    font-size: 17px;
    line-height: 1.55;
    margin: 0 0 20px;
    max-width: 60ch;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-width: none;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    border: 1px solid var(--color-accent-border);
    margin: 0;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    margin: 0;
  }

  .meta {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .meta-head h2 {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-fg-strong);
    margin: 8px 0 16px;
    letter-spacing: -0.015em;
  }

  .meta-links {
    font-size: 13.5px;
    color: var(--color-fg-muted);
    margin: 0 0 18px;
    max-width: none;
  }
  .meta-links a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .meta-links a:hover { color: var(--color-accent-hover); }
  .meta-links .arr {
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .meta-links .sep {
    color: var(--color-fg-faint);
    margin: 0 6px;
  }

  /* The Source code block is rendered by Astro's <Code> component,
     which emits a Shiki-styled <pre> with inline background + per-token
     colors. We just constrain the box. */
  .meta :global(pre.astro-code) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .example { padding: 36px 0 72px; }
    .example-header h1 { font-size: 32px; }
  }
</style>
