{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*", "src/**/*.astro", "astro.config.mjs", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules"]
}
