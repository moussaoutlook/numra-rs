---
// src/components/Header.astro
//
// Top nav for the marketing site. Sticky, glass-blurred, with brand
// mark + version pill on the left, link cluster + search hint + GitHub
// on the right.

const NUMRA_VERSION = 'v0.1.0';

const navItems = [
  { href: 'https://book.numra-rs.org',                 label: 'Book',     external: true  },
  { href: '/api',                                      label: 'API',      external: false },
  { href: 'https://examples.numra-rs.org',             label: 'Examples', external: true  },
  { href: '/cite',                                     label: 'Cite',     external: false },
];
---

<nav class="site-nav" aria-label="Primary">
  <div class="nav-inner">
    <div class="nav-left">
      <a href="/" class="brand" aria-label="Numra home">
        <img
          class="brand-logo"
          src="/numra_logo_no_BG.svg"
          alt="Numra"
          width="92"
          height="30"
        />
        <span class="ver-pill">{NUMRA_VERSION}</span>
      </a>
    </div>

    <div class="nav-right">
      <ul class="nav-links">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              {...(item.external ? { rel: 'noopener' } : {})}
            >{item.label}</a>
          </li>
        ))}
      </ul>
      <a
        class="gh-pill"
        href="https://github.com/moussaoutlook/numra-rs"
        rel="noopener"
        aria-label="Numra on GitHub"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        <span>GitHub</span>
        <span class="gh-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(251, 250, 247, 0.85);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 12px 28px;
    gap: 32px;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-fg-strong);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand:hover { color: var(--color-fg-strong); }

  .brand-logo {
    height: 30px;
    width: auto;
    display: block;
  }

  .ver-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--color-bg-elevated);
    font-weight: 500;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-links li { margin: 0; }

  .nav-links a {
    color: var(--color-fg);
    text-decoration: none;
    font-weight: 500;
  }

  .nav-links a:hover { color: var(--color-fg-strong); }

  .gh-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    font-size: 13px;
    color: var(--color-fg);
    font-weight: 500;
    background: var(--color-bg-elevated);
    text-decoration: none;
  }

  .gh-pill:hover {
    border-color: var(--color-border-strong);
    color: var(--color-fg-strong);
  }

  .gh-pill svg {
    color: var(--color-fg-muted);
    flex-shrink: 0;
  }

  .gh-pill .gh-arrow {
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
  }

  @media (max-width: 540px) {
    .ver-pill { display: none; }
    .gh-pill span:not(.gh-arrow) { display: none; }
  }
</style>
