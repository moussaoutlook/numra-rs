---
// src/components/Header.astro

const navItems = [
  { href: 'https://book.numra-rs.org', label: 'Book', external: true },
  { href: '/api', label: 'API', external: false },
  { href: 'https://github.com/moussaoutlook/numra-rs', label: 'GitHub', external: true },
];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="Numra home">
      <img
        class="brand-logo brand-logo-light"
        src="/numra_logo_no_BG.svg"
        alt="Numra"
        width="120"
        height="40"
      />
      <img
        class="brand-logo brand-logo-dark"
        src="/numra_logo_white-text_no_BG.svg"
        alt=""
        aria-hidden="true"
        width="120"
        height="40"
      />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              {...(item.external ? { rel: 'noopener' } : {})}
            >{item.label}</a>
          </li>
        ))}
        <li>
          <a class="btn-install" href="/install">Install</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-fg);
    font-weight: 600;
  }

  .brand-logo {
    height: auto;
    display: block;
  }
  /* Show the light-mode logo by default; swap to the white-text variant
     when the user is in dark mode. The other variant is hidden via
     `display: none` so screen readers and search crawlers see only one. */
  .brand-logo-dark { display: none; }
  [data-theme="dark"] .brand-logo-light { display: none; }
  [data-theme="dark"] .brand-logo-dark { display: block; }

  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .primary-nav a {
    color: var(--color-fg);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .primary-nav a:hover {
    color: var(--color-accent);
  }

  .btn-install {
    background: var(--color-accent);
    color: var(--color-bg) !important;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 600 !important;
  }

  .btn-install:hover {
    background: var(--color-accent-hover);
    color: var(--color-bg) !important;
  }

  @media (max-width: 720px) {
    .primary-nav ul { gap: var(--space-3); }
  }
</style>
