---
// src/components/Footer.astro

const year = new Date().getFullYear();

const footerSections = [
  {
    title: 'Docs',
    links: [
      { href: 'https://book.numra-rs.org',     label: 'Book',          external: true  },
      { href: '/api',                          label: 'API reference', external: false },
      { href: 'https://examples.numra-rs.org', label: 'Examples',      external: true  },
      { href: '/cite',                         label: 'Cite',          external: false },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: 'https://github.com/moussaoutlook/numra-rs',          label: 'GitHub',    external: true  },
      { href: 'https://github.com/moussaoutlook/numra-rs/releases', label: 'Releases',  external: true  },
      { href: '/changelog',                                         label: 'Changelog', external: false },
      { href: '/roadmap',                                           label: 'Roadmap',   external: false },
    ],
  },
  {
    title: 'Engineering',
    links: [
      { href: '/features',  label: 'Features',         external: false },
      { href: '/stability', label: 'Stability policy', external: false },
      { href: '/install',   label: 'Install',          external: false },
      { href: '/community', label: 'Community',        external: false },
    ],
  },
  {
    title: 'Licensing',
    links: [
      { href: '/license',    label: 'Academic / non-commercial', external: false },
      { href: '/commercial', label: 'Commercial licensing',      external: false },
      { href: '/privacy',    label: 'Privacy',                   external: false },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="b" aria-label="Numra home">
          <img
            class="brand-logo"
            src="/numra_logo_no_BG.svg"
            alt="Numra"
            width="100"
            height="33"
          />
        </a>
        <p>
          Composable numerical methods for Rust. A research project of
          Spectral Automata, distributed under the Numra Academic and
          Research License.
        </p>
      </div>

      {footerSections.map((section) => (
        <div class="foot-col">
          <h5>{section.title}</h5>
          {section.links.map((link) => (
            <a
              href={link.href}
              {...(link.external ? { rel: 'noopener' } : {})}
            >{link.label}</a>
          ))}
        </div>
      ))}
    </div>

    <div class="foot-bottom">
      <span>
        © {year} Spectral Automata · NARL-1.0
      </span>
      <span>
        <a href="https://spectralautomata.com" rel="noopener">
          A Spectral Automata project
        </a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    padding: 56px 0 28px;
    margin-top: var(--space-9);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  .foot-brand .b {
    display: inline-flex;
    align-items: center;
    margin-bottom: 12px;
    text-decoration: none;
  }

  .foot-brand .brand-logo {
    height: 33px;
    width: auto;
    display: block;
  }

  .foot-brand p {
    font-size: 13.5px;
    color: var(--color-fg-muted);
    max-width: 36ch;
    line-height: 1.55;
    margin: 0;
  }

  .foot-col h5 {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg);
    font-weight: 500;
    margin: 0 0 14px;
  }

  .foot-col a {
    display: block;
    color: var(--color-fg-muted);
    font-size: 13.5px;
    padding: 3px 0;
    text-decoration: none;
  }

  .foot-col a:hover {
    color: var(--color-fg-strong);
  }

  .foot-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .foot-bottom a { color: var(--color-fg-muted); }
  .foot-bottom a:hover { color: var(--color-fg-strong); }

  @media (max-width: 1100px) {
    .foot-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; }
    .foot-grid > div:nth-child(5) { grid-column: span 4; }
  }

  @media (max-width: 720px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
  }
</style>
