---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Changelog"
  description="Numra's release notes. The canonical changelog lives at CHANGELOG.md in the repository."
  canonicalPath="/changelog"
>
  <section class="changelog">
    <div class="container-narrow">
      <h1>Changelog.</h1>

      <p class="lede">
        Numra's release notes live in
        <a
          href="https://github.com/moussaoutlook/numra-rs/blob/main/CHANGELOG.md"
          rel="noopener"
        ><code>CHANGELOG.md</code></a>
        in the repository — that file is canonical.
      </p>

      <h2>Where to look</h2>
      <ul>
        <li>
          <a
            href="https://github.com/moussaoutlook/numra-rs/blob/main/CHANGELOG.md"
            rel="noopener"
          >CHANGELOG.md</a> — every release with notes, in
          Keep-a-Changelog format.
        </li>
        <li>
          <a
            href="https://github.com/moussaoutlook/numra-rs/releases"
            rel="noopener"
          >GitHub releases</a> — tagged releases with attached
          tarballs and Zenodo DOIs.
        </li>
        <li>
          <a
            href="https://docs.rs/numra"
            rel="noopener"
          >docs.rs</a> — per-version Rust API documentation,
          hosted automatically on every <code>cargo publish</code>.
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .changelog { padding: var(--space-8) 0; }
  h1 { margin-bottom: var(--space-5); }
  h2 {
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    margin-bottom: var(--space-6);
    max-width: var(--measure);
  }
  ul {
    max-width: var(--measure);
  }
  ul li {
    margin-block: var(--space-2);
  }
  code {
    font-size: 0.92em;
    background: var(--color-code-bg);
    padding: 0.05em 0.4em;
    border-radius: var(--radius-sm);
  }
</style>
