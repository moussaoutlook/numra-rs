---
// src/pages/index.astro
//
// Numra home page (v2). Sections, in order:
//   1. Hero (headline + ctas + install + side code window + stat tiles)
//   2. Status bar (CI / version / API stability / docs / license)
//   3. Capabilities (4 grouped categories of subsystems with icons)
//   4. Composability (a worked code example with annotations)
//   5. Solver matrix (every IVP solver in the workspace)
//   6. Benchmarks (real /figures/* with real provenance)
//   7. Architecture (3 layers, real crate names from the workspace)
//   8. Engineering posture (3 commitments)
//   9. Where to start + cite block
//
// Do not reorder. Do not add carousels, modals, or scroll-triggered
// animations.

import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { version, conceptDoi, releaseYear } from '../lib/citation';

import iconOde         from '../assets/icons/ode.png';
import iconSde         from '../assets/icons/sde.png';
import iconDde         from '../assets/icons/dde.png';
import iconFde         from '../assets/icons/fde.png';
import iconIde         from '../assets/icons/ide.png';
import iconPde         from '../assets/icons/pde.png';
import iconOptim       from '../assets/icons/optim.png';
import iconControl     from '../assets/icons/control.png';
import iconSensitivity from '../assets/icons/sensitivity.png';
import iconUq          from '../assets/icons/uq.png';
import iconLinalg      from '../assets/icons/linalg.png';
import iconQuad        from '../assets/icons/quad.png';
import iconSignal      from '../assets/icons/signal.png';
import iconStats       from '../assets/icons/stats.png';
import iconAutodiff    from '../assets/icons/autodiff.png';
import iconCoreTypes   from '../assets/icons/core-types.png';
import iconErrorModel  from '../assets/icons/error-model.png';
import iconDiagnostics from '../assets/icons/diagnostics.png';
import iconBenchHarness from '../assets/icons/bench-harness.png';

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://numra-rs.org/#website',
      url: 'https://numra-rs.org/',
      name: 'Numra',
      description: 'Composable numerical methods for Rust.',
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': 'https://numra-rs.org/#software',
      name: 'Numra',
      description:
        'A Rust library for numerical methods in scientific computing, providing composable solvers for ODEs, SDEs, DDEs, FDEs, IDEs, PDEs, and SPDEs, plus optimization, optimal control, linear algebra, quadrature, FFT, statistics, and automatic differentiation.',
      applicationCategory: 'ScientificComputing',
      programmingLanguage: 'Rust',
      operatingSystem: 'Cross-platform',
      license: 'https://github.com/moussaoutlook/numra-rs/blob/main/LICENSE',
      codeRepository: 'https://github.com/moussaoutlook/numra-rs',
      url: 'https://numra-rs.org/',
      author: {
        '@type': 'Person',
        name: 'Moussa Leblouba',
        affiliation: { '@type': 'Organization', name: 'University of Sharjah' },
      },
    },
  ],
};

// Capability rows. Each maps a subsystem (book chapter concept) to one
// or more workspace crates, with a short blurb that's true today.
//
// `link` is the deep-link into the book — keep it in sync with
// website/book/astro.config.mjs sidebar slugs (trailing slash required;
// the book builds with `trailingSlash: 'always'`).
const BOOK = 'https://book.numra-rs.org';
const capCategories = [
  {
    num: '01',
    name: 'Differential equations',
    sub: 'Initial-value problems, stochastic forcing, delay, fractional, integro, and PDE method-of-lines.',
    rows: [
      { icon: iconOde, name: 'Ordinary (ODE)',         desc: 'DoPri5, Tsit5, Vern6/7/8, Radau5, BDF, ESDIRK. Adaptive step, dense output, events.',     chapter: 'numra-ode',                  link: `${BOOK}/ch02-solving-odes/your-first-ode/` },
      { icon: iconSde, name: 'Stochastic (SDE)',       desc: 'Euler–Maruyama, Milstein, SRA1, SRA2. Diagonal, scalar, and general noise structures.',  chapter: 'numra-sde',                  link: `${BOOK}/ch04-beyond-odes/stochastic-des/` },
      { icon: iconDde, name: 'Delay (DDE)',            desc: 'Constant and state-dependent delays with history-function dispatch.',                    chapter: 'numra-dde',                  link: `${BOOK}/ch04-beyond-odes/delay-des/` },
      { icon: iconFde, name: 'Fractional (FDE)',       desc: 'Caputo derivatives (0 < α ≤ 1) via the L1 scheme. Mittag-Leffler reference functions.',  chapter: 'numra-fde',                  link: `${BOOK}/ch04-beyond-odes/fractional-des/` },
      { icon: iconIde, name: 'Integro-differential',   desc: 'Volterra type-2 kernels via quadrature and a Prony solver for sum-of-exponentials.',     chapter: 'numra-ide',                  link: `${BOOK}/ch04-beyond-odes/integro-des/` },
      { icon: iconPde, name: 'Partial (PDE / SPDE)',   desc: 'Method of lines for 1D/2D/3D problems with analytical Jacobians. Stochastic forcing.',   chapter: 'numra-pde · numra-spde',     link: `${BOOK}/ch04-beyond-odes/partial-des/` },
    ],
  },
  {
    num: '02',
    name: 'Optimization & control',
    sub: 'Continuous and constrained optimization, plus trajectory and adjoint methods.',
    rows: [
      { icon: iconOptim,       name: 'Optimization',          desc: 'BFGS, L-BFGS, Nelder–Mead, Levenberg–Marquardt, gradient and gradient-free methods.', chapter: 'numra-optim',     link: `${BOOK}/ch05-optimization/unconstrained/` },
      { icon: iconControl,     name: 'Optimal control',       desc: 'ODE-constrained optimization. Single shooting, multiple shooting, collocation.',      chapter: 'numra-ocp',       link: `${BOOK}/ch10-optimal-control/shooting-methods/` },
      { icon: iconSensitivity, name: 'Sensitivity analysis',      desc: 'Forward sensitivity via an augmented ParametricOdeSystem. Analytical or FD Jacobians. Composes with any ODE solver.', chapter: 'numra-ode',              link: `${BOOK}/ch11-uncertainty/sensitivity-analysis/` },
      { icon: iconUq,          name: 'Uncertainty quantification', desc: 'First-order GUM and Monte Carlo propagation through ODE parameters. Uncertain<S> mean/variance primitive in core.', chapter: 'numra-ode · numra-core', link: `${BOOK}/ch11-uncertainty/error-propagation/` },
    ],
  },
  {
    num: '03',
    name: 'Algebra & signals',
    sub: 'The lower-level primitives that the higher subsystems rest on, with first-class extension points.',
    rows: [
      { icon: iconLinalg,   name: 'Linear algebra',           desc: 'Dense and sparse via faer, factorizations, eigenproblems. Solver-integration extensions.', chapter: 'numra-linalg',                    link: `${BOOK}/ch06-linear-algebra/matrices-and-vectors/` },
      { icon: iconQuad,     name: 'Integration & interp',     desc: 'Adaptive quadrature, Gauss–Kronrod, splines, barycentric interpolation.',                  chapter: 'numra-integrate · numra-interp',  link: `${BOOK}/ch07-calculus-and-analysis/numerical-integration/` },
      { icon: iconSignal,   name: 'Signal processing',        desc: 'Digital filters (IIR/FIR), resampling, peak detection.',                                   chapter: 'numra-signal',                    link: `${BOOK}/ch08-signal-processing/filtering-signals/` },
      { icon: iconStats,    name: 'Statistics',               desc: 'Distributions, hypothesis tests, descriptive statistics.',                                 chapter: 'numra-stats',                     link: `${BOOK}/ch09-statistics/descriptive-stats/` },
      { icon: iconAutodiff, name: 'Automatic differentiation', desc: 'Forward-mode Dual<S> and reverse-mode Var with tape. Gradient, Jacobian, and Hessian utilities.',                            chapter: 'numra-autodiff',                  link: `${BOOK}/ch07-calculus-and-analysis/automatic-differentiation/` },
    ],
  },
  {
    num: '04',
    name: 'Foundations & tooling',
    sub: 'The shared types, error model, and instrumentation that hold the rest of the workspace together.',
    rows: [
      { icon: iconCoreTypes,    name: 'Core types',         desc: 'Real scalars (f32/f64), Vector/Matrix traits, Signal abstractions, Uncertain<S>. The lingua franca of every crate.', chapter: 'numra-core',    link: `${BOOK}/ch01-introduction/architecture-overview/` },
      { icon: iconErrorModel,   name: 'Error model',        desc: 'A single error enum with cause chains across every subsystem.',                                chapter: 'numra-core',    link: `${BOOK}/ch01-introduction/architecture-overview/` },
      { icon: iconDiagnostics,  name: 'Diagnostics',   desc: 'SolverStats on every result — accepted/rejected steps, function/Jacobian/LU evaluations. Debug-only Jacobian-flag consistency checks.', chapter: 'numra-ode',   link: `${BOOK}/appendix/solver-reference/` },
      { icon: iconBenchHarness, name: 'Bench harness', desc: 'Criterion benchmarks with JSON results. Every figure ships with provenance metadata: commit, rustc, hardware, repro script.',         chapter: 'numra-bench', link: `${BOOK}/ch13-performance/` },
    ],
  },
];

// Architecture layers. Real crate names from the workspace.
const archLayers = [
  {
    num: 'LAYER 03',
    name: 'High-level subsystems',
    tag: 'depends on layers 01–02',
    crates: [
      'numra-ode', 'numra-sde', 'numra-dde', 'numra-fde', 'numra-ide',
      'numra-pde', 'numra-spde', 'numra-optim', 'numra-ocp', 'numra-fit',
      'numra-stats', 'numra-signal',
    ],
  },
  {
    num: 'LAYER 02',
    name: 'Numerical primitives',
    tag: 'linear algebra · interpolation · autodiff',
    crates: [
      'numra-linalg', 'numra-interp', 'numra-integrate', 'numra-autodiff',
      'numra-fft', 'numra-nonlinear', 'numra-special',
    ],
  },
  {
    num: 'LAYER 01',
    name: 'Foundations',
    tag: 'shared types · errors · benchmarking',
    crates: [
      'numra-core', 'numra-bench', 'numra',
    ],
  },
];
---

<BaseLayout
  title="Numra"
  description="Composable numerical methods for Rust. ODEs, SDEs, DDEs, FDEs, IDEs, PDEs, and SPDEs in one workspace, alongside optimization, optimal control, linear algebra, quadrature, FFT, statistics, and automatic differentiation."
  canonicalPath="/"
  jsonLd={homeJsonLd}
>
  <!-- 1. Hero ============================================================ -->
  <header class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">
            <span class="dot">●</span>
            An open-source project for the scientific and engineering community
          </p>
          <h1>Composable numerical methods <em>for Rust.</em></h1>
          <p class="hero-desc">
            A workspace of twenty crates for scientific computing —
            differential equations, optimization, linear algebra,
            quadrature, FFT, statistics, automatic differentiation —
            built against shared types, shared error handling, and
            shared performance discipline. Designed to compose without
            glue.
          </p>

          <div class="hero-ctas">
            <a class="btn btn-primary" href="/install">
              Get started <span class="arr">→</span>
            </a>
            <a class="btn btn-secondary" href="https://book.numra-rs.org" rel="noopener">
              Browse the book
            </a>
            <a class="btn btn-ghost" href="/api">
              API reference <span class="arr">↗</span>
            </a>
          </div>

          <div class="hero-install" role="group" aria-label="Cargo install command">
            <span class="lbl">Cargo</span>
            <code>cargo add numra</code>
          </div>

          <div class="hero-meta">
            <span class="tag teal">edition 2021</span>
            <span class="tag">MSRV 1.83</span>
            <span class="tag">faer · ndarray</span>
            <span class="tag">NARL-1.0</span>
          </div>
        </div>

        <div class="hero-side">
          <div class="codewin">
            <div class="codewin-head">
              <span class="dots" aria-hidden="true">
                <i style="background-color: rgb(236, 111, 107)"></i>
                <i style="background-color: rgb(255, 210, 0)"></i>
                <i style="background-color: rgb(12, 192, 0)"></i>
              </span>
              <span class="file">examples/lotka_volterra.rs</span>
              <span class="runtime">cargo run --release</span>
            </div>
            <pre><Fragment set:html={`<span class="k">use</span> numra::ode::{<span class="t">OdeProblem</span>, <span class="t">Solver</span>, <span class="t">SolverOptions</span>, <span class="t">Tsit5</span>};

<span class="c">// Lotka–Volterra:  dx/dt = α x − β x y,  dy/dt = −γ y + δ x y</span>
<span class="k">let</span> lotka = <span class="t">OdeProblem</span>::<span class="fn">new</span>(
    |_t, y: &amp;[<span class="t">f64</span>], dy: &amp;<span class="k">mut</span> [<span class="t">f64</span>]| {
        dy[<span class="nu">0</span>] =  <span class="nu">1.5</span> * y[<span class="nu">0</span>] - <span class="nu">1.0</span> * y[<span class="nu">0</span>] * y[<span class="nu">1</span>];
        dy[<span class="nu">1</span>] = -<span class="nu">3.0</span> * y[<span class="nu">1</span>] + <span class="nu">1.0</span> * y[<span class="nu">0</span>] * y[<span class="nu">1</span>];
    },
    <span class="nu">0.0</span>, <span class="nu">15.0</span>,
    vec![<span class="nu">1.0</span>, <span class="nu">1.0</span>],
);

<span class="k">let</span> opts = <span class="t">SolverOptions</span>::default().<span class="fn">rtol</span>(<span class="nu">1e-8</span>).<span class="fn">atol</span>(<span class="nu">1e-10</span>);
<span class="k">let</span> sol  = <span class="t">Tsit5</span>::<span class="fn">solve</span>(&amp;lotka, lotka.t0, lotka.tf, &amp;lotka.y0, &amp;opts)?;

<span class="k">for</span> (t, y) <span class="k">in</span> sol.<span class="fn">iter</span>() {
    println!(<span class="s">"t = {t:6.3}  x = {:.4}  y = {:.4}"</span>, y[<span class="nu">0</span>], y[<span class="nu">1</span>]);
}`} /></pre>
          </div>

          <div class="hero-side-foot">
            <div class="cell">
              <div class="num">20</div>
              <div class="lbl">Crates</div>
            </div>
            <div class="cell">
              <div class="num">14+</div>
              <div class="lbl">IVP solvers</div>
            </div>
            <div class="cell">
              <div class="num">7</div>
              <div class="lbl">Equation classes</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. Status bar ====================================================== -->
  <div class="statusbar">
    <div class="statusbar-inner">
      <span class="item"><span class="ic" aria-hidden="true"></span> CI <b>passing</b> · multi-platform</span>
      <span class="item"><span class="ic amber" aria-hidden="true"></span> API status <b>pre-1.0</b> · stabilizing</span>
      <span class="item"><span class="ic" aria-hidden="true"></span> Docs <b>green</b></span>
      <span class="item">License <b>NARL-1.0</b></span>
    </div>
  </div>

  <!-- 3. Capabilities ==================================================== -->
  <section>
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow"><span class="dot">●</span> Coverage</p>
        <div class="col-r">
          <h2>Twenty crates, one workspace.</h2>
          <p class="lede">
            Every entry below is a publicly tested crate. The book has a
            chapter for each — derivations, convergence proofs, and
            worked examples.
          </p>
        </div>
      </div>

      {capCategories.map((cat) => (
        <div class="cap-cat">
          <div>
            <div class="cap-cat-h">
              <span class="num">{cat.num}</span>
              <h3>{cat.name}</h3>
            </div>
            <p class="cap-cat-sub">{cat.sub}</p>
          </div>
          <div class="cap-list">
            {cat.rows.map((row) => (
              <a href={row.link} rel="noopener" class="cap-row">
                <span class="sym">
                  <Image src={row.icon} alt="" loading="lazy" width={146} height={146} />
                </span>
                <div class="body">
                  <span class="name">{row.name}</span>
                  <span class="desc">{row.desc}</span>
                </div>
                <span class="ch">{row.chapter}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. Composability =================================================== -->
  <section>
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow"><span class="dot">●</span> Composition</p>
        <div class="col-r">
          <h2>Subsystems that compose without glue.</h2>
          <p class="lede">
            Fitting a parameterized ODE to noisy data with proper
            gradients usually means stitching together three or four
            libraries. In Numra it's a single workflow because every
            subsystem is built against the same types and the same
            error model.
          </p>
        </div>
      </div>

      <div class="compose-grid">
        <div class="codewin">
          <div class="codewin-head">
            <span class="dots" aria-hidden="true">
              <i style="background-color: rgb(247, 70, 64)"></i>
              <i style="background-color: rgb(255, 210, 0)"></i>
              <i style="background-color: rgb(12, 192, 0)"></i>
            </span>
            <span class="file">examples/decay_fit.rs</span>
            <span class="runtime">ode + autodiff + optim</span>
          </div>
          <pre><Fragment set:html={`<span class="k">use</span> numra::ode::{<span class="t">Bdf</span>, <span class="t">SolverOptions</span>};
<span class="k">use</span> numra::ode::sensitivity::{<span class="fn">solve_forward_sensitivity</span>, <span class="t">ParametricOdeSystem</span>};
<span class="k">use</span> numra::optim::{<span class="fn">lm_minimize</span>, <span class="t">LmOptions</span>};

<span class="c">// Observed: a sample of the decaying state at t = 4.</span>
<span class="k">let</span> observed = <span class="nu">0.14</span>;

<span class="c">// Parametric model: dy/dt = -k·y, with k unknown.</span>
<span class="k">struct</span> <span class="t">Decay</span> { k: <span class="t">f64</span> }
<span class="k">impl</span> <span class="t">ParametricOdeSystem</span>&lt;<span class="t">f64</span>&gt; <span class="k">for</span> <span class="t">Decay</span> {
    <span class="k">fn</span> <span class="fn">n_states</span>(&amp;self) -&gt; <span class="t">usize</span>  { <span class="nu">1</span> }
    <span class="k">fn</span> <span class="fn">n_params</span>(&amp;self) -&gt; <span class="t">usize</span>  { <span class="nu">1</span> }
    <span class="k">fn</span> <span class="fn">params</span>(&amp;self)   -&gt; &amp;[<span class="t">f64</span>] { std::slice::from_ref(&amp;self.k) }
    <span class="k">fn</span> <span class="fn">rhs_with_params</span>(&amp;self, _t: <span class="t">f64</span>, y: &amp;[<span class="t">f64</span>], p: &amp;[<span class="t">f64</span>], dy: &amp;<span class="k">mut</span> [<span class="t">f64</span>]) {
        dy[<span class="nu">0</span>] = -p[<span class="nu">0</span>] * y[<span class="nu">0</span>];
    }
}

<span class="c">// One Bdf solve of the augmented system gives state AND analytical sensitivity dy/dk.</span>
<span class="k">let</span> solve_with_sens = |k: &amp;[<span class="t">f64</span>]| {
    <span class="k">let</span> sys = <span class="t">Decay</span> { k: k[<span class="nu">0</span>] };
    <span class="fn">solve_forward_sensitivity</span>::&lt;<span class="t">Bdf</span>, <span class="t">f64</span>, _&gt;(
        &amp;sys, <span class="nu">0.0</span>, <span class="nu">4.0</span>, &amp;[<span class="nu">1.0</span>],
        &amp;<span class="t">SolverOptions</span>::default().<span class="fn">rtol</span>(<span class="nu">1e-8</span>).<span class="fn">atol</span>(<span class="nu">1e-12</span>),
    ).<span class="fn">expect</span>(<span class="s">"augmented solve failed"</span>)
};

<span class="k">let</span> residual = |k: &amp;[<span class="t">f64</span>], r: &amp;<span class="k">mut</span> [<span class="t">f64</span>]| {
    <span class="k">let</span> sol  = solve_with_sens(k);
    <span class="k">let</span> last = sol.<span class="fn">len</span>() - <span class="nu">1</span>;
    r[<span class="nu">0</span>] = sol.<span class="fn">y_at</span>(last)[<span class="nu">0</span>] - observed;
};
<span class="k">let</span> jacobian = |k: &amp;[<span class="t">f64</span>], j: &amp;<span class="k">mut</span> [<span class="t">f64</span>]| {
    <span class="k">let</span> sol  = solve_with_sens(k);
    <span class="k">let</span> last = sol.<span class="fn">len</span>() - <span class="nu">1</span>;
    j[<span class="nu">0</span>] = sol.<span class="fn">dyi_dpj</span>(last, <span class="nu">0</span>, <span class="nu">0</span>);
};

<span class="k">let</span> fit = <span class="fn">lm_minimize</span>(residual, jacobian, &amp;[<span class="nu">0.3</span>], <span class="nu">1</span>, &amp;<span class="t">LmOptions</span>::default())?;
println!(<span class="s">"k = {:.4}  (final cost {:.2e})"</span>, fit.x[<span class="nu">0</span>], fit.f);`} /></pre>
        </div>

        <div class="annot">
          <div class="annot-row">
            <span class="n">01</span>
            <div>
              <div class="l">Analytical Jacobian</div>
              Forward sensitivity supplies the exact Jacobian to the
              optimizer. No finite-difference fallback, no step-size
              tuning, no spurious noise from differing solver paths
              between perturbations.
            </div>
          </div>
          <div class="annot-row">
            <span class="n">02</span>
            <div>
              <div class="l">One error model</div>
              Each crate carries its own configuration
              (<code class="inline">SolverOptions</code> for ODE,
              <code class="inline">LmOptions</code> for LM), but the
              error types convert into <code class="inline">NumraError</code>
              so the same <code class="inline">?</code> operator
              propagates across the whole pipeline.
            </div>
          </div>
          <div class="annot-row">
            <span class="n">03</span>
            <div>
              <div class="l">Pluggable at the type level</div>
              Replacing <code class="inline">Bdf</code> with <code class="inline">Radau5</code>,
              or the optimizer with a global search method, doesn't
              require changing the integration code. Composition is at
              the type level.
            </div>
          </div>
          <div class="annot-row">
            <span class="n">04</span>
            <div>
              <div class="l">Worked example</div>
              See the Robertson stiff-kinetics fit in the book for the
              full version, including weighted residuals and
              confidence-interval reporting.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Solver matrix =================================================== -->
  <section>
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow"><span class="dot">●</span> Solver matrix</p>
        <div class="col-r">
          <h2>Pick the solver that fits your problem.</h2>
          <p class="lede">
            Every IVP solver in the workspace, with the properties that
            decide which one you reach for. Generated from the same
            metadata that drives the test suite — if a column says yes,
            there's a regression test enforcing it.
          </p>
        </div>
      </div>

      <div class="matrix-wrap">
        <table class="matrix">
          <thead>
            <tr>
              <th>Solver</th>
              <th>Family</th>
              <th class="center">Order</th>
              <th class="center">Adaptive</th>
              <th class="center">Stiff</th>
              <th class="center">Dense out</th>
              <th class="center">Events</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr class="subhead"><td colspan="8">Explicit Runge–Kutta</td></tr>
            <tr><td class="solver">DoPri5</td><td class="dim">RK</td><td class="center">5(4)</td><td class="center"><span class="y">●</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">Dormand–Prince. Default for non-stiff.</td></tr>
            <tr><td class="solver">Tsit5</td><td class="dim">RK</td><td class="center">5(4)</td><td class="center"><span class="y">●</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">Tsitouras. Lower error coefficients than DoPri5.</td></tr>
            <tr><td class="solver">Vern6</td><td class="dim">RK</td><td class="center">6(5)</td><td class="center"><span class="y">●</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">High-order, smooth solutions.</td></tr>
            <tr><td class="solver">Vern7</td><td class="dim">RK</td><td class="center">7(6)</td><td class="center"><span class="y">●</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">Loose tolerances on long horizons.</td></tr>
            <tr><td class="solver">Vern8</td><td class="dim">RK</td><td class="center">8(7)</td><td class="center"><span class="y">●</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">Tight tolerances, smooth dynamics.</td></tr>
            <tr><td class="solver">Vern9</td><td class="dim">RK</td><td class="center">9(8)</td><td class="center"><span class="y">●</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">When you really need accuracy.</td></tr>

            <tr class="subhead"><td colspan="8">Implicit / stiff</td></tr>
            <tr><td class="solver">Radau5</td><td class="dim">IRK</td><td class="center">5</td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">A-stable, L-stable. The reference for stiff.</td></tr>
            <tr><td class="solver">BDF</td><td class="dim">Multistep</td><td class="center">1–5</td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">Variable-order. Stiff and DAE-friendly.</td></tr>
            <tr><td class="solver">ESDIRK4</td><td class="dim">SDIRK</td><td class="center">4(3)</td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="center"><span class="y">●</span></td><td class="dim">Diagonally-implicit, mildly stiff.</td></tr>

            <tr class="subhead"><td colspan="8">Stochastic</td></tr>
            <tr><td class="solver">EulerMaruyama</td><td class="dim">SDE</td><td class="center">0.5</td><td class="center"><span class="n">○</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="partial">◐</span></td><td class="dim">Strong order 0.5, weak 1.0.</td></tr>
            <tr><td class="solver">Milstein</td><td class="dim">SDE</td><td class="center">1.0</td><td class="center"><span class="n">○</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="partial">◐</span></td><td class="dim">Diagonal noise.</td></tr>
            <tr><td class="solver">SRA / SRI</td><td class="dim">SDE</td><td class="center">1.5</td><td class="center"><span class="y">●</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="n">○</span></td><td class="center"><span class="partial">◐</span></td><td class="dim">Adaptive, additive / Itô noise.</td></tr>
          </tbody>
        </table>
      </div>

      <div class="legend" aria-label="Matrix legend">
