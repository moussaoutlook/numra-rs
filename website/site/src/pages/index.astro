---
// src/pages/index.astro
//
// Numra home page. The section order is intentional. Do not reorder.
// Do not add carousels, modals, or scroll-triggered animations. The
// page is intentionally short.

import BaseLayout from '../layouts/BaseLayout.astro';

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://numra-rs.org/#website',
      url: 'https://numra-rs.org/',
      name: 'Numra',
      description: 'Composable numerical methods for Rust.',
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': 'https://numra-rs.org/#software',
      name: 'Numra',
      description:
        'A Rust library for numerical methods in scientific computing, providing composable solvers for ODEs, SDEs, DDEs, FDEs, IDEs, PDEs, and SPDEs.',
      applicationCategory: 'ScientificComputing',
      programmingLanguage: 'Rust',
      operatingSystem: 'Cross-platform',
      license: 'https://github.com/moussaoutlook/numra-rs/blob/main/LICENSE',
      codeRepository: 'https://github.com/moussaoutlook/numra-rs',
      url: 'https://numra-rs.org/',
      author: {
        '@type': 'Person',
        name: 'Moussa Leblouba',
        affiliation: { '@type': 'Organization', name: 'University of Sharjah' },
      },
    },
  ],
};
---

<BaseLayout
  title="Numra"
  description="Composable numerical methods for Rust. ODE, SDE, DDE, FDE, IDE, PDE, and SPDE solvers in one library."
  canonicalPath="/"
  jsonLd={homeJsonLd}
>
  <!-- 1. Hero ============================================================ -->
  <section class="hero">
    <div class="container-narrow">
      <h1>Composable numerical methods for Rust.</h1>
      <p class="lede">
        ODEs, SDEs, DDEs, FDEs, IDEs, PDEs, and SPDEs in one library —
        with dense output, event detection, and adaptive integration
        that compose like Lego.
      </p>

      <div class="cta-row">
        <a class="btn btn-primary" href="/install">Get started</a>
        <a class="btn btn-secondary" href="https://book.numra-rs.org">Read the book</a>
      </div>

      <!-- Real, runnable code. Highest-signal element on the page. -->
      <div class="hero-code">
        <pre><code class="language-rust">{`use numra::ode::{solve_ivp, Tsit5};
use numra::prelude::*;

// Lorenz system: dx/dt = σ(y - x), dy/dt = x(ρ - z) - y, dz/dt = xy - βz
let lorenz = |_t: f64, y: &[f64], dy: &mut [f64]| {
    let (s, r, b) = (10.0, 28.0, 8.0 / 3.0);
    dy[0] = s * (y[1] - y[0]);
    dy[1] = y[0] * (r - y[2]) - y[1];
    dy[2] = y[0] * y[1] - b * y[2];
};

let sol = solve_ivp(lorenz, (0.0, 40.0), &[1.0, 1.0, 1.0])
    .method(Tsit5::new())
    .rtol(1e-8)
    .atol(1e-10)
    .dense_output(true)
    .run()?;`}</code></pre>
      </div>
    </div>
  </section>

  <!-- 2. One library, many equations ===================================== -->
  <section class="capability-section">
    <div class="container">
      <h2>One library, many equations.</h2>
      <p>
        Numra covers the full equation classes scientific computing
        depends on, with a unified API surface so you compose solvers
        instead of fighting them.
      </p>

      <table class="capability-matrix">
        <thead>
          <tr>
            <th scope="col">Equation class</th>
            <th scope="col">Solvers</th>
            <th scope="col" class="col-narrow">Adaptive</th>
            <th scope="col" class="col-narrow">Stiff</th>
            <th scope="col">Book chapter</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">ODE / DAE</th>
            <td>DoPri5, Tsit5, Vern6&ndash;9, Radau5, BDF, ESDIRK</td>
            <td class="col-narrow tick" aria-label="Yes">&#10003;</td>
            <td class="col-narrow tick" aria-label="Yes">&#10003;</td>
            <td><a href="https://book.numra-rs.org/ch02-solving-odes/your-first-ode/">Solving ODEs</a></td>
          </tr>
          <tr>
            <th scope="row">Stiff systems</th>
            <td>Radau5, BDF, ESDIRK; auto-detection</td>
            <td class="col-narrow tick" aria-label="Yes">&#10003;</td>
            <td class="col-narrow tick" aria-label="Yes">&#10003;</td>
            <td><a href="https://book.numra-rs.org/ch03-stiff-systems/what-is-stiffness/">Stiff systems</a></td>
          </tr>
          <tr>
            <th scope="row">SDE</th>
            <td>Euler&ndash;Maruyama, Milstein, SRA, SRI</td>
            <td class="col-narrow tick" aria-label="Yes">&#10003;</td>
            <td class="col-narrow dash" aria-label="Not applicable">&mdash;</td>
            <td><a href="https://book.numra-rs.org/ch04-beyond-odes/stochastic-des/">Stochastic DEs</a></td>
          </tr>
          <tr>
            <th scope="row">DDE</th>
            <td>Runge&ndash;Kutta with delay handling</td>
            <td class="col-narrow tick" aria-label="Yes">&#10003;</td>
            <td class="col-narrow dash" aria-label="Not applicable">&mdash;</td>
            <td><a href="https://book.numra-rs.org/ch04-beyond-odes/delay-des/">Delay DEs</a></td>
          </tr>
          <tr>
            <th scope="row">FDE</th>
            <td>Caputo, Riemann&ndash;Liouville</td>
            <td class="col-narrow dash" aria-label="Not applicable">&mdash;</td>
            <td class="col-narrow dash" aria-label="Not applicable">&mdash;</td>
            <td><a href="https://book.numra-rs.org/ch04-beyond-odes/fractional-des/">Fractional DEs</a></td>
          </tr>
          <tr>
            <th scope="row">IDE</th>
            <td>Volterra, Fredholm</td>
            <td class="col-narrow dash" aria-label="Not applicable">&mdash;</td>
            <td class="col-narrow dash" aria-label="Not applicable">&mdash;</td>
            <td><a href="https://book.numra-rs.org/ch04-beyond-odes/integro-des/">Integro DEs</a></td>
          </tr>
          <tr>
            <th scope="row">PDE / SPDE</th>
            <td>Method of lines, finite differences, finite elements; stochastic forcing</td>
            <td class="col-narrow tick" aria-label="Yes">&#10003;</td>
            <td class="col-narrow tick" aria-label="Yes">&#10003;</td>
            <td><a href="https://book.numra-rs.org/ch04-beyond-odes/partial-des/">Partial DEs</a></td>
          </tr>
          <tr>
            <th scope="row">Optimization</th>
            <td>Gradient descent, BFGS, L-BFGS, Nelder&ndash;Mead, interior-point</td>
            <td class="col-narrow dash" aria-label="Not applicable">&mdash;</td>
            <td class="col-narrow dash" aria-label="Not applicable">&mdash;</td>
            <td><a href="https://book.numra-rs.org/ch05-optimization/unconstrained/">Optimization</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 3. Composability =================================================== -->
  <section class="composability-section">
    <div class="container">
      <h2>Composability in action.</h2>
      <p>
        Solvers in Numra are values, not frameworks. You wire them
        together. The output of one solver is the input of the next —
        with dense output, you can interpolate, integrate, transform,
        and reduce.
      </p>

      <div class="composability-grid">
        <figure class="composability-figure">
          <svg
            class="flow-diagram"
            viewBox="0 0 720 110"
            role="img"
            aria-labelledby="diagram-1-title diagram-1-desc"
            xmlns="http://www.w3.org/2000/svg"
          >
            <title id="diagram-1-title">ODE composability pipeline</title>
            <desc id="diagram-1-desc">
              An ODE problem flows through DoPri5, dense output,
              cubic spline interpolation, and Gauss&ndash;Kronrod quadrature
              to produce a scalar result.
            </desc>
            <defs>
              <marker id="arrow-1" viewBox="0 0 10 10" refX="9" refY="5"
                markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
              </marker>
            </defs>
            <g class="flow-nodes">
              <g transform="translate(0, 35)">
                <rect width="100" height="40" rx="6" />
                <text x="50" y="24">OdeProblem</text>
              </g>
              <g transform="translate(120, 35)">
                <rect width="100" height="40" rx="6" />
                <text x="50" y="24">DoPri5</text>
              </g>
              <g transform="translate(240, 35)">
                <rect width="110" height="40" rx="6" />
                <text x="55" y="24">dense_output</text>
              </g>
              <g transform="translate(370, 35)">
                <rect width="120" height="40" rx="6" />
                <text x="60" y="24">spline_interp</text>
              </g>
              <g transform="translate(510, 35)">
                <rect width="140" height="40" rx="6" />
                <text x="70" y="24">gauss_kronrod</text>
              </g>
              <g transform="translate(670, 35)" class="flow-result">
                <rect width="50" height="40" rx="6" />
                <text x="25" y="24">f64</text>
              </g>
            </g>
            <g class="flow-edges" stroke="currentColor" fill="none">
              <line x1="100" y1="55" x2="120" y2="55" marker-end="url(#arrow-1)" />
              <line x1="220" y1="55" x2="240" y2="55" marker-end="url(#arrow-1)" />
              <line x1="350" y1="55" x2="370" y2="55" marker-end="url(#arrow-1)" />
              <line x1="490" y1="55" x2="510" y2="55" marker-end="url(#arrow-1)" />
              <line x1="650" y1="55" x2="670" y2="55" marker-end="url(#arrow-1)" />
            </g>
          </svg>
          <figcaption>
            ODE &rarr; dense output &rarr; interpolation &rarr; quadrature.
            Verified by
            <a
              href="https://github.com/moussaoutlook/numra-rs/blob/main/numra/tests/interop_workflows.rs"
              rel="noopener"
            ><code>workflow_ode_interp_integrate</code></a>.
          </figcaption>
        </figure>

        <figure class="composability-figure">
          <svg
            class="flow-diagram"
            viewBox="0 0 720 110"
            role="img"
            aria-labelledby="diagram-2-title diagram-2-desc"
            xmlns="http://www.w3.org/2000/svg"
          >
            <title id="diagram-2-title">PDE composability pipeline</title>
            <desc id="diagram-2-desc">
              A PDE problem is discretized via the method of lines, solved
              by Numra's automatic stiffness-aware solver, reduced to a norm,
              and turned into a scalar statistic.
            </desc>
            <g class="flow-nodes">
              <g transform="translate(0, 35)">
                <rect width="100" height="40" rx="6" />
                <text x="50" y="24">PdeProblem</text>
              </g>
              <g transform="translate(120, 35)">
                <rect width="150" height="40" rx="6" />
                <text x="75" y="24">method_of_lines</text>
              </g>
              <g transform="translate(290, 35)">
                <rect width="100" height="40" rx="6" />
                <text x="50" y="24">Auto::solve</text>
              </g>
              <g transform="translate(410, 35)">
                <rect width="140" height="40" rx="6" />
                <text x="70" y="24">reduce_norm_l2</text>
              </g>
              <g transform="translate(570, 35)" class="flow-result">
                <rect width="100" height="40" rx="6" />
                <text x="50" y="24">Statistic</text>
              </g>
            </g>
            <g class="flow-edges" stroke="currentColor" fill="none">
              <line x1="100" y1="55" x2="120" y2="55" marker-end="url(#arrow-1)" />
              <line x1="270" y1="55" x2="290" y2="55" marker-end="url(#arrow-1)" />
              <line x1="390" y1="55" x2="410" y2="55" marker-end="url(#arrow-1)" />
              <line x1="550" y1="55" x2="570" y2="55" marker-end="url(#arrow-1)" />
            </g>
          </svg>
          <figcaption>
            PDE &rarr; method of lines &rarr; automatic solver &rarr; reduction &rarr; statistic.
            Verified by
            <a
              href="https://github.com/moussaoutlook/numra-rs/blob/main/numra/tests/interop_workflows.rs"
              rel="noopener"
            ><code>workflow_pde_statistics</code></a>.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 4. Performance and correctness ===================================== -->
  <section class="evidence-section">
    <div class="container">
      <h2>Performance and correctness.</h2>
      <div class="evidence-grid">
        <div class="evidence-card">
          <h3>Benchmarks</h3>
          <figure class="bench-figure">
            <img
              src="/figures/home_tolerance_runtime.svg"
              alt="Log-log plot of DoPri5 wall-clock runtime versus requested relative tolerance, integrating the Lorenz system from t=0 to t=20. Seven tolerances from 1e-3 to 1e-9. Empirical power-law slope is approximately 0.17."
              loading="lazy"
              width="700"
              height="430"
            />
            <figcaption>
              DoPri5 on Lorenz across seven tolerances. Adaptive step
              control means stricter tolerance only costs sub-linearly.
              <a
                href="https://github.com/moussaoutlook/numra-rs/blob/main/numra-bench/benches/solvers.rs"
                rel="noopener"
              >View the reproduction script</a>; full hardware and
              toolchain provenance lives in the SVG sidecar.
            </figcaption>
          </figure>
        </div>
        <div class="evidence-card">
          <h3>Correctness</h3>
          <figure class="bench-figure">
            <img
              src="/figures/home_correctness_map.svg"
              alt="Heatmap of regression-test coverage. Rows are equation classes (ODE/DAE, SDE, Optimization, Linear algebra, Quadrature, Interpolation, FFT). Columns are invariant types (convergence order, analytic/golden value, statistical bands, event localization). Filled cells indicate test coverage."
              loading="lazy"
              width="560"
              height="400"
            />
            <figcaption>
              Every solver family has at least one regression invariant
              under test. <a
                href="https://github.com/moussaoutlook/numra-rs/blob/main/docs/audit/correctness-test-map.md"
                rel="noopener"
              >Browse the full test &rarr; method map</a>.
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Built for science =============================================== -->
  <section class="science-section">
    <div class="container">
      <h2>Built for science.</h2>
      <div class="science-grid">
        <div>
          <h3>Citable</h3>
          <p>
            DOI per release via Zenodo, BibTeX on <a href="/cite">/cite</a>.
            Cite Numra in papers without hesitation.
          </p>
        </div>
        <div>
          <h3>Versioned</h3>
          <p>
            Stable MSRV, semver from 1.0, deprecation windows.
            See <a href="/stability">/stability</a>.
          </p>
        </div>
        <div>
          <h3>Evidence-based</h3>
          <p>
            Every benchmark plot ships with its commit SHA, hardware,
            and a reproduction script.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. License at a glance ============================================= -->
  <section class="license-section">
    <div class="container-narrow">
      <h2>License.</h2>
      <p>
        Numra is free for non-commercial academic and research use under
        the Numra Academic &amp; Research License (Non-Commercial) v1.0.
        Commercial use requires a separate license.
      </p>
      <div class="cta-row">
        <a class="btn btn-secondary" href="/license">Read the license</a>
        <a class="btn btn-secondary" href="/commercial">Commercial licensing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-9) 0 var(--space-8);
  }

  .hero h1 {
    margin-bottom: var(--space-4);
  }

  .lede {
    font-size: var(--text-xl);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-6);
    max-width: var(--measure);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .btn {
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background var(--motion-fast) var(--ease-out),
                color      var(--motion-fast) var(--ease-out),
                border     var(--motion-fast) var(--ease-out);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-bg);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-fg);
    border-color: var(--color-border-strong);
  }
  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero-code {
    margin-top: var(--space-5);
  }

  .hero-code pre {
    box-shadow: var(--shadow-2);
  }

  section + section {
    border-top: 1px solid var(--color-border);
    padding: var(--space-8) 0;
  }

  .evidence-grid,
  .science-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .evidence-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
  }

  .license-section {
    padding: var(--space-7) 0 var(--space-9);
  }

  .capability-matrix {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }
  .capability-matrix th,
  .capability-matrix td {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .capability-matrix thead th {
    font-weight: 600;
    color: var(--color-fg-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-bottom: 2px solid var(--color-border-strong);
    background: var(--color-bg-subtle);
  }
  .capability-matrix tbody th[scope="row"] {
    font-weight: 600;
    color: var(--color-fg);
    white-space: nowrap;
  }
  .capability-matrix tbody tr:hover {
    background: var(--color-bg-subtle);
  }
  .capability-matrix .col-narrow {
    width: 5rem;
    text-align: center;
  }
  .capability-matrix .tick {
    color: var(--color-accent);
    font-weight: 700;
  }
  .capability-matrix .dash {
    color: var(--color-fg-subtle);
  }
  .capability-matrix a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .capability-matrix a:hover {
    border-bottom-color: var(--color-accent);
  }

  .composability-grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-5);
  }
  .composability-figure {
    margin: 0;
  }
  .flow-diagram {
    width: 100%;
    height: auto;
    color: var(--color-fg-muted);
    overflow: visible;
  }
  .flow-diagram .flow-nodes rect {
    fill: var(--color-bg-elevated);
    stroke: var(--color-border-strong);
    stroke-width: 1;
  }
  .flow-diagram .flow-nodes text {
    fill: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: middle;
    dominant-baseline: middle;
  }
  .flow-diagram .flow-result rect {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
  }
  .flow-diagram .flow-result text {
    fill: var(--color-accent);
    font-weight: 600;
  }
  .flow-diagram .flow-edges line {
    stroke-width: 1.5;
  }
  .composability-figure figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    text-align: center;
  }
  .composability-figure figcaption code {
    font-size: 0.92em;
    background: var(--color-code-bg);
    padding: 0.05em 0.4em;
    border-radius: var(--radius-sm);
  }
  .composability-figure figcaption a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .composability-figure figcaption a:hover {
    border-bottom-color: var(--color-accent);
  }

  .bench-figure {
    margin: 0;
  }
  .bench-figure img {
    width: 100%;
    height: auto;
    display: block;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }
  .bench-figure figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
  .bench-figure figcaption a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .bench-figure figcaption a:hover {
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .capability-matrix,
    .capability-matrix thead,
    .capability-matrix tbody,
    .capability-matrix tr,
    .capability-matrix th,
    .capability-matrix td {
      display: block;
    }
    .capability-matrix thead {
      display: none;
    }
    .capability-matrix tbody tr {
      border-bottom: 1px solid var(--color-border);
      padding-block: var(--space-3);
    }
    .capability-matrix tbody th[scope="row"] {
      font-size: var(--text-base);
      border-bottom: none;
      padding-bottom: var(--space-2);
    }
    .capability-matrix tbody td {
      border-bottom: none;
      padding-block: var(--space-1);
    }
    .capability-matrix .col-narrow {
      display: inline-block;
      width: auto;
      text-align: left;
      padding-right: var(--space-3);
    }
    .capability-matrix .col-narrow::before {
      content: attr(aria-label) ": ";
      color: var(--color-fg-muted);
      font-weight: 600;
      font-size: var(--text-xs);
    }
  }
</style>
