{
  "_comment": "Lighthouse CI configuration for the Numra book (book.numra-rs.org). Loosened from the marketing-site budget because Starlight ships ~150 KB of UI runtime and Pagefind ships its WASM search index. Math-heavy chapters and chapters with embedded SVGs (e.g. ch13-performance) make the marketing-site budget unrealistic. These thresholds are still strict — they're the bar for a content-heavy docs site, not the bar for a brochure.",

  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": ["uses-http2"]
      }
    },

    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance":   ["error", { "minScore": 0.90 }],
        "categories:accessibility": ["error", { "minScore": 1.00 }],
        "categories:best-practices":["error", { "minScore": 0.95 }],
        "categories:seo":           ["error", { "minScore": 0.95 }],

        "first-contentful-paint":  ["error", { "maxNumericValue": 2000 }],
        "largest-contentful-paint":["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time":     ["error", { "maxNumericValue": 200  }],
        "speed-index":             ["error", { "maxNumericValue": 3000 }],

        "uses-text-compression":      "error",
        "uses-responsive-images":     "error",
        "modern-image-formats":       "error",
        "efficient-animated-content": "error",
        "no-unload-listeners":        "error",
        "render-blocking-resources":  ["error", { "maxNumericValue": 400 }],

        "color-contrast":     "error",
        "html-has-lang":      "error",
        "image-alt":          "error",
        "label":              "error",
        "link-name":          "error",
        "valid-lang":         "error",
        "meta-viewport":      "error",
        "document-title":     "error",
        "html-lang-valid":    "error",

        "is-on-https":             "error",
        "uses-https":              "error",
        "no-vulnerable-libraries": "error",
        "csp-xss":                 ["warn",  {}],

        "_comment_pwa": "PWA category and audits removed in Lighthouse 12 — do not add them.",
        "uses-rel-preload":              "off",
        "uses-rel-preconnect":           "off",
        "non-composited-animations":     "warn",
        "unused-css-rules":              "warn",
        "unused-javascript":             "warn",
        "_comment_third_party_summary":  "Sources outside our control (CF beacon, Pagefind WASM) — warn, do not error.",
        "third-party-summary":           "warn",

        "_comment_book_specific": "Pagefind ships its search WASM payload on most pages; do not error on bundle size for it.",
        "total-byte-weight":             ["warn", { "maxNumericValue": 819200 }]
      }
    },

    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
