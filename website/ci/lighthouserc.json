{
  "_comment": "Lighthouse CI configuration for the Numra website. LHCI 0.15.x bundles Lighthouse 12; the PWA category and several legacy audits (uses-https, no-unload-listeners, no-vulnerable-libraries) were removed upstream and intentionally absent from assertions below. is-on-https is the current HTTPS-validation audit. Audit IDs go directly as keys in `assertions` — LHCI parses any key there as an audit ID, so do not put commentary keys inside that object.",

  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": ["uses-http2"]
      }
    },

    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance":   ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1.00 }],
        "categories:best-practices":["error", { "minScore": 0.95 }],
        "categories:seo":           ["error", { "minScore": 0.95 }],

        "first-contentful-paint":  ["error", { "maxNumericValue": 1500 }],
        "largest-contentful-paint":["error", { "maxNumericValue": 1500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time":     ["error", { "maxNumericValue": 100  }],
        "speed-index":             ["error", { "maxNumericValue": 2500 }],

        "uses-text-compression":      "error",
        "uses-responsive-images":     "error",
        "modern-image-formats":       "error",
        "efficient-animated-content": "error",

        "color-contrast":     "error",
        "html-has-lang":      "error",
        "image-alt":          "error",
        "label":              "error",
        "link-name":          "error",
        "valid-lang":         "error",
        "meta-viewport":      "error",
        "document-title":     "error",
        "html-lang-valid":    "error",

        "is-on-https":             "error",
        "csp-xss":                 ["warn",  {}],

        "uses-rel-preload":              "off",
        "uses-rel-preconnect":           "off",
        "non-composited-animations":     "warn",
        "unused-css-rules":              "warn",
        "unused-javascript":             "warn",
        "third-party-summary":           "warn"
      }
    },

    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
